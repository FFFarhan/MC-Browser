HOST=0.0.0.0
PORT=8787
ALLOWED_ORIGINS=https://your-game.example
# Public STUN assists ordinary NAT traversal; it does not relay traffic.
TURN_URLS=stun:stun.cloudflare.com:3478
# For TURN fallback, add your own coturn URLs and set its matching REST shared secret.
# TURN_URLS=turn:turn.example.net:3478?transport=udp,turns:turn.example.net:5349?transport=tcp,stun:stun.cloudflare.com:3478
# TURN_SHARED_SECRET=replace-with-a-long-random-coturn-rest-secret
TURN_CREDENTIAL_TTL_SECONDS=3600
